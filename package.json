{
  "name": "gov-nav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run prepare:data && vite",
    "build": "npm run prepare:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "prepare:data": "tsx scripts/prepare-public-data.ts",
    "test:e2e": "playwright test",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run validate:data && npm run test && npm run build && npm run check:bundle",
    "import:regions": "tsx scripts/import-regions.ts"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
